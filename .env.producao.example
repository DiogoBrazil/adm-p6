# Modelo do `.env.producao`, que aponta o script de migração para o servidor de
# produção. Copie, preencha e NÃO versione: o arquivo real tem senha.
#
#   cp .env.producao.example .env.producao
#   ./scripts/migrar_dados_legados.sh --env-file .env.producao
#
# O IP tem de ser o da máquina do banco na rede que vocês compartilham — não o
# de um adaptador virtual (WSL, Hyper-V, Docker), que só existe lá dentro.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

DATABASE_URL=postgres://USUARIO:SENHA@HOST:5432/BANCO
