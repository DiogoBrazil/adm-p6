# Banco de dados (PostgreSQL). O docker-compose.yml deste repositório sobe
# exatamente esta configuração.
DB_HOST=localhost
DB_PORT=5438
DB_NAME=adm_p6_db
DB_USER=adm_p6_user
DB_PASSWORD=adm_p6_password

# Modo de TLS da conexão da APLICAÇÃO (`app_state.rs::from_env`). Ausente vale
# `prefer`, que é o que serve para o Postgres do docker-compose: ele não fala
# TLS, e `prefer` cai para texto claro sem reclamar.
#
# Apontando este `.env` para produção (a Neon), use `verify-full` — não
# `require`. `require` criptografa mas não confere de quem é o certificado, e o
# que ele deixa passar é justamente um intermediário. O sqlx usa rustls com as
# raízes embutidas e valida a Neon até `verify-full`; foi medido.
#
# Cuidado: o `.env.producao` fica em `require`, e a diferença é real, não
# descuido. Aquele arquivo é lido pelo `psql`/`pg_dump` do container do
# docker-compose, que não tem pacote de certificados instalado e falha em
# `verify-full` com "certificate verify failed". Mesmo nome de variável, dois
# clientes com capacidades diferentes.
DB_SSLMODE=prefer

# Usada apenas pelas ferramentas de linha de comando do sqlx
# (cargo sqlx prepare / migrate). A aplicação monta a URL a partir das DB_* acima.
DATABASE_URL=postgres://adm_p6_user:adm_p6_password@localhost:5438/adm_p6_db
