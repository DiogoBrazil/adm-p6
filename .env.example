# Banco de dados (PostgreSQL). O docker-compose.yml deste repositório sobe
# exatamente esta configuração.
DB_HOST=localhost
DB_PORT=5438
DB_NAME=adm_p6_db
DB_USER=adm_p6_user
DB_PASSWORD=adm_p6_password

# Usada apenas pelas ferramentas de linha de comando do sqlx
# (cargo sqlx prepare / migrate). A aplicação monta a URL a partir das DB_* acima.
DATABASE_URL=postgres://adm_p6_user:adm_p6_password@localhost:5438/adm_p6_db
